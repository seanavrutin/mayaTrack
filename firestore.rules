rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /families/{familyId} {
      // Any authenticated user can read families (needed to find by join code)
      allow read: if request.auth != null;

      // Any authenticated user can create a family (if they include themselves as member)
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;

      // Members can update anything; non-members can only add themselves to the members array
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
        )
      );

      // Subcollections (feedings, diapers, pumpings, vitaminD, settings): members only
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }
  }
}
